{
  "name": "fragolina",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "npm run prepare-app && expo start --dev-client",
    "web": "npm run prepare-app && expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "icons": "node scripts/make-icon.mjs",
    "preview-shots": "node scripts/preview-shots.mjs",
    "ipa-local-notes": "node scripts/ipa-local-notes.mjs",
    "doctor": "node scripts/doctor.mjs",
    "clean": "node scripts/clean.mjs",
    "prepare-app": "node scripts/sync-user-art.mjs && node scripts/setup-web.mjs",
    "postinstall": "node scripts/setup-web.mjs",
    "ship": "node scripts/ship.mjs release",
    "ship:dev": "node scripts/ship.mjs dev-client",
    "ship:release": "node scripts/ship.mjs release",
    "test": "vitest run",
    "backend:sql": "node scripts/build-sql.mjs",
    "backend:sqltest": "node scripts/sql-check.mjs",
    "backend:check": "node scripts/backend-check.mjs",
    "setup-env": "node scripts/setup-env.mjs"
  },
  "dependencies": {
    "@bacons/apple-targets": "^5.0.0",
    "@expo-google-fonts/bagel-fat-one": "^0.4.0",
    "@expo-google-fonts/figtree": "^0.4.1",
    "@expo-google-fonts/gluten": "^0.4.2",
    "@expo-google-fonts/onest": "^0.4.2",
    "@expo/metro-runtime": "~58.0.17",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/react-native-skia": "2.14.0",
    "@supabase/supabase-js": "^2.119.0",
    "expo": "~58.0.23",
    "expo-asset": "~58.0.20",
    "expo-clipboard": "^58.0.4",
    "expo-constants": "~58.0.15",
    "expo-dev-client": "~58.0.18",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "react": "^19.3.0",
    "react-dom": "19.3.0",
    "react-native": "^0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^58.0.4",
    "playwright-core": "^1.65.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
